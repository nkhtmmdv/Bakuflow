# Supabase project settings (Project Settings -> API in the Supabase dashboard).
# The URL and anon key are safe to expose to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: SERVER-SIDE ONLY. Never prefix this with NEXT_PUBLIC_,
# never import it from a Client Component, and never commit a real value.
# Used only by lib/supabase/admin.ts (trust-score service layer) and the
# seed script (supabase/seed/seed.ts).
SUPABASE_SERVICE_ROLE_KEY=

# Optional: a free vector tile style URL for /map (MapLibre). Defaults to
# the free, no-key-required OpenFreeMap "liberty" style if unset.
NEXT_PUBLIC_MAP_STYLE_URL=
